{
  "_comment": "Example ArtCraft MCP entries. Paths depend on where ArtCraft installed its CLIs; replace <HOME> with your home folder. Add them with `claude mcp add` or copy into ~/.claude.json under mcpServers.",
  "mcpServers": {
    "effectcraft": {
      "type": "stdio",
      "command": "<HOME>/.local/share/artcraft-cli/effectcraft/effectcraft-cli",
      "args": ["mcp", "--bridge", "9877"]
    },
    "filmcraft": {
      "type": "stdio",
      "command": "<HOME>/.local/share/artcraft-cli/filmcraft-mcp.sh",
      "args": []
    },
    "photocraft": {
      "type": "stdio",
      "command": "/Applications/PhotoCraft.app/Contents/MacOS/photocraft-cli",
      "args": ["mcp", "--bridge", "127.0.0.1:7878", "--control-token-file", "<HOME>/.config/artcraft/photocraft-control.token"]
    }
  }
}
